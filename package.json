{
  "name": "repplus-ultra",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Multi-client MCP server exposing rep+ HTTP history and security analysis to Claude, Codex and ChatGPT.",
  "bin": {
    "repplus-ultra": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "pack:mcpb": "npm run build:mcpb && npx @anthropic-ai/mcpb pack mcpb dist/repplus.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@anthropic-ai/mcpb": "^2.1.2",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20"
    }
  }
}
